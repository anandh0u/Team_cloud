# Copy to .env and fill in:  cp .env.example .env
# Required values fail closed: the app refuses to start and names the missing or
# malformed variable, rather than guessing a default. Every feature below except
# "Core" and "ESP32" is optional and switches off when its first setting is empty.

# --- Core -------------------------------------------------------------------------
# true  = simulate the ESP32 (arm, gripper, pulse, MPU6050): no hardware needed
# false = talk to the real ESP32 (ESP32_CONTROLLER_URL becomes required)
MOCK_HARDWARE=true
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
# Selects config/intents/<lang>.json and config/responses/<lang>.json
ASSISTANT_LANGUAGE=en
CATALOG_DIR=config

# --- ESP32 controller ---------------------------------------------------------------
# Printed in the ESP32's Serial Monitor at boot, e.g. http://192.168.1.50
ESP32_CONTROLLER_URL=http://192.168.x.x
ESP32_HTTP_TIMEOUT_S=3
# Extra attempts for safe-to-repeat calls only (GETs, /stop, /resume).
# Motion commands (pose, home, gripper) are never re-sent automatically.
ESP32_HTTP_RETRIES=2
ESP32_RETRY_BACKOFF_S=0.5
# Longest a single arm move may take before it counts as failed.
ESP32_MOVE_TIMEOUT_S=20

# --- Access and HTTPS ---------------------------------------------------------------
# Password for every page and API call (browser login box, any user name).
# REQUIRED before making the server reachable from the internet.
ACCESS_PASSWORD=
# Phone browsers only allow the microphone and live camera on HTTPS pages. Create the
# certificate with scripts/make_cert.sh. Empty HTTPS_PORT = plain HTTP only.
HTTPS_PORT=8443
TLS_CERT_FILE=data/tls/cert.pem
TLS_KEY_FILE=data/tls/key.pem

# --- Vision: objects on the bedside table --------------------------------------------
# YOLO model; a missing official .pt file is downloaded on first start. Empty = vision off.
YOLO_MODEL=data/models/yolo11n.pt
# Minimum detection score (0.01-1). Small, shiny objects like spoons score 0.3-0.5.
YOLO_CONFIDENCE=0.25
# "Where is my phone?" / "I want spoon" only trust camera pictures this recent.
SCENE_MAX_AGE_S=120

# --- Patient condition and activity history -------------------------------------------
# Pose model for position and movement on the dashboard. Empty = off. Observations only
# ("lying", "no movement seen"), never a diagnosis.
YOLO_POSE_MODEL=data/models/yolo11n-pose.pt
# Pose runs in the background at most this often (it shares the CPU with detection).
POSE_INTERVAL_S=3
# Dashboard notes after no movement seen / out of camera view for this long.
STILL_ATTENTION_MIN=20
AWAY_ATTENTION_MIN=10
# How often to read the pulse sensor and MPU6050 from the ESP32. Empty = don't poll.
SENSOR_POLL_S=10
# Pose readings for /report (numbers only, never pictures). Needs YOLO_POSE_MODEL.
DATABASE_PATH=data/patient.db
HISTORY_DAYS=30

# --- Voice: Sarvam AI speech-to-text, translation, text-to-speech ----------------------
# Empty key = voice off (typing still works; the phone's own voice reads replies).
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
# translate = any supported Indian language in, English text out (what the parser
# understands). transcribe = text in the spoken language.
SARVAM_STT_MODE=translate
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
SARVAM_TTS_LANGUAGE=en-IN
SARVAM_TIMEOUT_S=20
# true = answer in the language the patient spoke (reply translated, then spoken).
SARVAM_REPLY_IN_SPOKEN_LANGUAGE=true
SARVAM_TRANSLATE_MODEL=sarvam-translate:v1

# --- AI: understanding, replies and report summaries (OpenAI) --------------------------
# Empty key = no AI: fixed rules and replies, reports without the written summary.
# Only text and numbers are sent, never camera pictures.
LLM_PROVIDER=openai
OPENAI_API_KEY=
LLM_MODEL=gpt-5.4-mini
LLM_TIMEOUT_S=60
# true = the AI understands sentences the fixed rules don't match (choosing only real
# actions, objects and contacts) and phrases replies from what actually happened.
# Emergency and STOP always use the fixed rules and replies; so does any AI failure.
LLM_ASSISTANT=true
LLM_ASSISTANT_TIMEOUT_S=6

# --- People ------------------------------------------------------------------------
# Full international numbers. The caregiver receives emergency alerts and calls, and
# CAREGIVER_NAME is understood too ("call Ayisha").
CAREGIVER_NAME=
CAREGIVER_PHONE=
# Other contacts from config/intents/en.json (son, daughter, wife, husband, doctor):
# CONTACT_PHONES=son=+919876543210, daughter=+919812345678
CONTACT_PHONES=

# --- Text messages -------------------------------------------------------------------
# MOCK = only logged. ANDROID_GATEWAY = real SMS from an Android phone's SIM through the
# "SMS Gateway for Android" app (sms-gate.app) in Local Server mode.
COMMUNICATION_BACKEND=MOCK
# Shown in the gateway app under Local Server, e.g. http://192.168.1.20:8080
ANDROID_GATEWAY_URL=
ANDROID_GATEWAY_USERNAME=
ANDROID_GATEWAY_PASSWORD=
ANDROID_GATEWAY_TIMEOUT_S=10

# --- Automatic phone calls (MacroDroid on the bedside phone) --------------------------
# http://<phone IP>:<MacroDroid HTTP server port>/<trigger path>. Use a hard-to-guess
# path: anyone on the Wi-Fi who knows it can make the phone dial. Empty = a call only
# opens the phone's dialler for someone to press call.
CALL_AUTOMATION_URL=
CALL_AUTOMATION_TIMEOUT_S=5
