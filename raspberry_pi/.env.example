# Copy to .env and fill in. Required values fail closed: the app refuses to
# start (with the variable name in the error) rather than guessing a default.

# --- Core (phase 1) -----------------------------------------------------------
# true  = simulate ESP32 controller, heartbeat, MPU6050, arm, camera
# false = talk to real hardware (ESP32_CONTROLLER_URL becomes required)
MOCK_HARDWARE=true
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
# Selects config/responses/<lang>.json for spoken replies (en first; ml, hi later)
ASSISTANT_LANGUAGE=en
# Folder holding poses.json, mock_hardware.json and responses/
CATALOG_DIR=config

# --- ESP32 controller (phase 2) -----------------------------------------------
ESP32_CONTROLLER_URL=http://192.168.x.x
ESP32_HTTP_TIMEOUT_S=3
# Extra attempts for safe-to-repeat calls only (GETs, /stop, /resume).
# Motion commands (pose, home, gripper) are never re-sent automatically.
ESP32_HTTP_RETRIES=2
ESP32_RETRY_BACKOFF_S=0.5
# Longest a single arm move may take before it counts as failed.
ESP32_MOVE_TIMEOUT_S=20

# --- Caregiver communication ----------------------------------------------------
# MOCK = log only (nothing is sent).
# ANDROID_GATEWAY = real SMS through the "SMS Gateway for Android" app (sms-gate.app)
#   in Local Server mode; needs the ANDROID_GATEWAY_* settings and CAREGIVER_PHONE below.
# WEBHOOK is not built yet.
COMMUNICATION_BACKEND=MOCK

# --- Camera (phase 4) ---------------------------------------------------------
ESP32_CAM_CAPTURE_URL=http://192.168.x.x/capture

# --- Object detection (YOLO on phone photos) --------------------------------
# Leave YOLO_MODEL empty to disable vision. A missing .pt file is downloaded on
# first start (yolo11n = smallest/fastest, fine on a Pi 5 CPU).
YOLO_MODEL=data/models/yolo11n.pt
# Minimum score (0.01-1) for a detection to be reported. Required when YOLO_MODEL is set.
YOLO_CONFIDENCE=0.35
# "Where is my phone?" only uses a photo taken within this many seconds.
SCENE_MAX_AGE_S=120

# --- Patient condition (dashboard) --------------------------------------------
# Pose model for posture and movement from the live camera. Empty = off.
# Observations only ("lying", "no movement seen"), never a diagnosis.
YOLO_POSE_MODEL=data/models/yolo11n-pose.pt
# Pose runs in the background at most this often (it shares the Pi's CPU with detection).
POSE_INTERVAL_S=3
# Dashboard notes: no movement seen for this long / patient out of camera view this long.
STILL_ATTENTION_MIN=20
AWAY_ATTENTION_MIN=10
# How often to read heartbeat + MPU6050 from the ESP32. Empty = don't poll.
SENSOR_POLL_S=10

# --- Access ----------------------------------------------------------------------
# Password for every page and API call (browser login box, any user name).
# REQUIRED before making the server reachable from the internet.
ACCESS_PASSWORD=

# --- Voice (Sarvam AI speech-to-text + text-to-speech) ----------------------
# Leave SARVAM_API_KEY empty to disable voice (typing still works). When it is
# set, every SARVAM_ setting below is required.
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
# translate = any supported Indian language in, English text out (what the intent
# parser understands). transcribe = text in the spoken language.
SARVAM_STT_MODE=translate
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
SARVAM_TTS_LANGUAGE=en-IN
SARVAM_TIMEOUT_S=20
# true = answer in the language the patient spoke (reply translated, then spoken).
SARVAM_REPLY_IN_SPOKEN_LANGUAGE=true
SARVAM_TRANSLATE_MODEL=sarvam-translate:v1

# --- HTTPS for the phone page --------------------------------------------------
# Phone browsers only allow the microphone and live camera on HTTPS pages. Leave
# HTTPS_PORT empty for plain HTTP only. Create the certificate with
# scripts/make_cert.sh (see README).
HTTPS_PORT=8443
TLS_CERT_FILE=data/tls/cert.pem
TLS_KEY_FILE=data/tls/key.pem

# --- AI summary of activity reports ---------------------------------------------
# openai (anthropic is not built yet). Empty key = reports without the AI summary.
# Only the report's numbers are sent to OpenAI, never camera pictures.
LLM_PROVIDER=openai
OPENAI_API_KEY=
LLM_MODEL=gpt-5.4-mini
LLM_TIMEOUT_S=60
# true = the AI also understands sentences the fixed rules don't match (choosing only real
# actions/objects/contacts) and phrases replies from what actually happened. Emergency and
# STOP always use the fixed rules and replies. Falls back to them if the AI is slow or fails.
LLM_ASSISTANT=true
LLM_ASSISTANT_TIMEOUT_S=6
ANTHROPIC_API_KEY=

# --- Activity history (reports) ---------------------------------------------------
# Pose readings (numbers only, no pictures) for /report. Needs YOLO_POSE_MODEL.
DATABASE_PATH=data/patient.db
HISTORY_DAYS=30

# --- SMS gateway + contacts (COMMUNICATION_BACKEND=ANDROID_GATEWAY) -------------
# Shown in the gateway app under Local Server, e.g. http://192.168.1.20:8080
ANDROID_GATEWAY_URL=
ANDROID_GATEWAY_USERNAME=
ANDROID_GATEWAY_PASSWORD=
ANDROID_GATEWAY_TIMEOUT_S=10
CAREGIVER_NAME=
# Full international numbers. CAREGIVER_PHONE receives emergency alerts.
CAREGIVER_PHONE=
# Other contacts from the intent catalog (son, daughter, wife, husband, doctor):
# CONTACT_PHONES=son=+919876543210, daughter=+919812345678
CONTACT_PHONES=

# --- Automatic calls from the bedside phone (MacroDroid) -------------------------
# MacroDroid's "HTTP Server Request" trigger + "Make Call" action dial with no tap
# (see README). Empty = calls only open the phone's dialler for someone to press call.
# Use a hard-to-guess path: anyone on the Wi-Fi who knows it can make the phone dial.
CALL_AUTOMATION_URL=
CALL_AUTOMATION_TIMEOUT_S=5
